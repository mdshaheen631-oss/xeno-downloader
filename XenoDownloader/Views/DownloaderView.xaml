<UserControl x:Class="XenoDownloader.Views.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="1000">
            <!-- Title -->
            <TextBlock Text="Media Downloader" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Text="Analyze media streams, select resolutions or audio formats, and download with multi-threaded speed." FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,24"/>

            <!-- URL Input Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="20">
                <StackPanel>
                    <TextBlock Text="Paste Video or Audio URL" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" Height="44" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PasteAndAnalyzeCommand}" Margin="0,0,12,0" Height="44" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPaste}" Fill="{StaticResource BrushTextPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Paste" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeCommand}" Height="44" Padding="22,0"
                                IsEnabled="{Binding IsAnalyzing, Converter={x:Null}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSpeed}" Fill="#050811" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Analyze Link" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Loading State -->
                    <Border Background="#1E2A44" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                            Visibility="{Binding IsAnalyzing, Converter={x:Null}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Probing media headers, streams, and platform metadata..." Foreground="{StaticResource BrushAccentCyan}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Error Alert -->
                    <Border Background="#2B1417" BorderBrush="{StaticResource BrushError}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"
                            Visibility="{Binding AnalysisError, Converter={x:Null}}">
                        <TextBlock Text="{Binding AnalysisError}" Foreground="{StaticResource BrushError}" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Analyzed Media Preview Card -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24" Margin="0,0,0,24"
                    Visibility="{Binding CurrentMedia, Converter={x:Null}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Media Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail or Placeholder -->
                        <Border Width="160" Height="100" CornerRadius="8" Background="#1B2233" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,20,0" ClipToBounds="True">
                            <Grid>
                                <Path Data="{StaticResource IconDownload}" Fill="{StaticResource BrushTextMuted}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding CurrentMedia.ThumbnailUrl}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>

                        <!-- Title & Meta -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Background="#1C2942" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentMedia.SourcePlatform}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentMedia.Title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estimated Size: " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding CurrentMedia.TotalSizeBytes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0"/>
                                <TextBlock Text="Format: " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding CurrentMedia.ContentType}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Options Section -->
                    <Border Grid.Row="1" Background="#111622" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Quality & Format Selection -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Select Quality / Format:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding CurrentMedia.Formats}" SelectedItem="{Binding SelectedFormat}"
                                          DisplayMemberPath="DisplayText" Height="40" VerticalContentAlignment="Center" Background="#161D2B" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!-- Save Location -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Download Directory:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding CustomDownloadFolder}" Height="40" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFolderCommand}" Height="40" Padding="14,0">
                                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextPrimary}" Width="16" Height="16" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Download Action Bar -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Streaming directly to disk using async pipeline with pause/resume support." FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartDownloadCommand}" Height="46" Padding="28,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Fill="#050811" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Start Download" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
