<UserControl x:Class="XenoDownloader.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="{StaticResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Browser Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="BtnBack" Style="{StaticResource IconButton}" Click="BtnBack_Click" ToolTip="Back" Margin="0,0,4,0">
                        <TextBlock Text="&#x2190;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    </Button>
                    <Button x:Name="BtnForward" Style="{StaticResource IconButton}" Click="BtnForward_Click" ToolTip="Forward" Margin="0,0,4,0">
                        <TextBlock Text="&#x2192;" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    </Button>
                    <Button x:Name="BtnRefresh" Style="{StaticResource IconButton}" Click="BtnRefresh_Click" ToolTip="Reload">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnHome" Style="{StaticResource IconButton}" Click="BtnHome_Click" ToolTip="YouTube Home" Margin="4,0,0,0">
                        <Path Data="{StaticResource IconHome}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Address Bar -->
                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtAddress" Style="{StaticResource ModernTextBoxStyle}" KeyDown="TxtAddress_KeyDown" Height="36" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnGo_Click" Height="36" Padding="12,0" Margin="6,0,0,0">
                        <TextBlock Text="Go" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

                <!-- Action Button: Send URL to Downloader -->
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="BtnDownloadCurrentPage_Click" Height="36" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Fill="#050811" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Analyze Page Media" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- WebView2 Browser Control Container -->
        <Grid Grid.Row="1">
            <!-- Loading indicator when initializing -->
            <Border x:Name="LoadingOverlay" Background="{StaticResource BrushBg}" Panel.ZIndex="10" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading Embedded Browser..." FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Powering video streaming with Microsoft WebView2 runtime." FontSize="13" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <wv2:WebView2 x:Name="WebViewControl"/>
        </Grid>

        <!-- Compliance & Status Footer -->
        <Border Grid.Row="2" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Integrated Browser: Supports YouTube, Vimeo, Archive.org, and direct video feeds. Operates strictly within platform policies without DRM bypass." 
                           FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{StaticResource BrushAccentCyan}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
