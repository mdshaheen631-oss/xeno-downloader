<UserControl x:Class="XenoDownloader.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Downloads Manager" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Monitor active download speeds, pause/resume tasks, or access completed files." FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PauseAllCommand}" Margin="0,0,8,0" ToolTip="Pause All">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPause}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Pause All"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResumeAllCommand}" Margin="0,0,8,0" ToolTip="Resume All">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Resume All"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCompletedCommand}" ToolTip="Clear Completed">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Clear List"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="All" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" Tag="All" Margin="0,0,6,0" Padding="12,6" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="Active" Style="{StaticResource {x:Type ToggleButton}}" Tag="Active" Margin="0,0,6,0" Padding="12,6" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="Completed" Style="{StaticResource {x:Type ToggleButton}}" Tag="Completed" Margin="0,0,6,0" Padding="12,6" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="Paused" Style="{StaticResource {x:Type ToggleButton}}" Tag="Paused" Margin="0,0,6,0" Padding="12,6" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"/>
                <RadioButton Content="Failed" Style="{StaticResource {x:Type ToggleButton}}" Tag="Failed" Padding="12,6" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Downloads List -->
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredDownloads}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0,0,0,12"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title & Status row -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                    <Border Background="#1A2438" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quality}" FontSize="11" Foreground="{StaticResource BrushAccentCyan}"/>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#1E2A44" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </Border>
                            </Grid>

                            <!-- Progress Bar -->
                            <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}" Value="{Binding ProgressPercentage}" Maximum="100" Margin="0,0,0,8"/>

                            <!-- Progress Stats & Actions -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stats -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding DownloadedSizeDisplay}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,16,0"/>

                                    <TextBlock Text="Speed: " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding SpeedDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,16,0"/>

                                    <TextBlock Text="ETA: " FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding EtaDisplay}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>

                                <!-- Item Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pause Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanPause, Converter={x:Null}}" ToolTip="Pause">
                                        <Path Data="{StaticResource IconPause}" Fill="{StaticResource BrushTextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Resume Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanResume, Converter={x:Null}}" ToolTip="Resume">
                                        <Path Data="{StaticResource IconPlay}" Fill="{StaticResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Retry Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={x:Null}}" ToolTip="Retry">
                                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushWarning}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Open File Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsCompleted, Converter={x:Null}}" ToolTip="Open File">
                                        <Path Data="{StaticResource IconFile}" Fill="{StaticResource BrushSuccess}" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Open Folder Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Open Containing Folder">
                                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                                    </Button>

                                    <!-- Cancel / Delete Button -->
                                    <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.RemoveDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Remove">
                                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
