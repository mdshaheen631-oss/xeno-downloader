<UserControl x:Class="XenoDownloader.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" MaxWidth="1000">
            <!-- Header Banner -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="24" Background="#131926">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Xeno Downloader" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="High-performance, lightweight native Windows media downloader and browser." FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A2333" CornerRadius="8" Padding="14,10" Margin="0,0,12,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Active" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveDownloadsCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A2333" CornerRadius="8" Padding="14,10" Margin="0,0,12,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Total Speed" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalSpeedDisplay}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A2333" CornerRadius="8" Padding="14,10">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Completed" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CompletedDownloadsCount}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Download Box -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="Quick Media Download" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="Paste any media or video URL below to analyze available formats and download directly to your PC." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Height="44" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PasteAndAnalyzeCommand}" Margin="0,0,12,0" Height="44" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPaste}" Fill="{StaticResource BrushTextPrimary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Paste" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeCommand}" Height="44" Padding="22,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Fill="#050811" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Analyze &amp; Download" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Error Alert if any -->
                    <Border Background="#2B1417" BorderBrush="{StaticResource BrushError}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0"
                            Visibility="{Binding AnalysisError, Converter={x:Null}}">
                        <TextBlock Text="{Binding AnalysisError}" Foreground="{StaticResource BrushError}" FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Explore & Quick Bookmarks -->
            <TextBlock Text="Supported Platforms &amp; Built-In Browser" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- YouTube -->
                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="16" HorizontalContentAlignment="Left"
                        Command="{Binding SendUrlFromBrowserCommand}" CommandParameter="https://www.youtube.com">
                    <StackPanel>
                        <TextBlock Text="YouTube" FontSize="16" FontWeight="Bold" Foreground="#FF3333" Margin="0,0,0,4"/>
                        <TextBlock Text="Browse &amp; Stream Videos" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Button>

                <!-- Vimeo -->
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,8,0" Padding="16" HorizontalContentAlignment="Left"
                        Command="{Binding SendUrlFromBrowserCommand}" CommandParameter="https://vimeo.com">
                    <StackPanel>
                        <TextBlock Text="Vimeo" FontSize="16" FontWeight="Bold" Foreground="#1AB7EA" Margin="0,0,0,4"/>
                        <TextBlock Text="High Quality Media" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Button>

                <!-- Internet Archive -->
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,8,0" Padding="16" HorizontalContentAlignment="Left"
                        Command="{Binding SendUrlFromBrowserCommand}" CommandParameter="https://archive.org/details/movies">
                    <StackPanel>
                        <TextBlock Text="Archive.org" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,4"/>
                        <TextBlock Text="Public Domain Media" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Button>

                <!-- Pexels Free Videos -->
                <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Padding="16" HorizontalContentAlignment="Left"
                        Command="{Binding SendUrlFromBrowserCommand}" CommandParameter="https://www.pexels.com/videos/">
                    <StackPanel>
                        <TextBlock Text="Pexels Video" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,4"/>
                        <TextBlock Text="Royalty-Free Stock" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Features Highlights -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Stream to Disk" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Zero RAM hogging. Large media files stream directly to storage in 64 KB buffers." FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Smart Resumption" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="HTTP Range headers allow pause, resume, and recovery from unexpected interruptions." FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Native Performance" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Pure .NET 8 WPF with asynchronous background pipelines. Never freezes the UI." FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
